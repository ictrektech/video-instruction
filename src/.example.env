# ============================================
# FastAPI Template - Example Environment Config
# ============================================
# Copy this file to .env and adjust values:
#   cp .example.env .env

# --- Application ---
APP_ENV=dev
APP_TITLE=fastapi-template
APP_VERSION=0.1.0
APP_PORT=8000

# --- Database ---
DB_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/mydatabase

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT ---
JWT_SECRET=change-me
JWT_EXPIRATION_SECONDS=604800

# --- Rate Limit ---
RATE_LIMIT_DEFAULT_PERMITS=10.0
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=1.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_CONFIG_PATH=config/log_conf.yaml

# --- CORS ---
# 多个源用逗号分隔，例如: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*
